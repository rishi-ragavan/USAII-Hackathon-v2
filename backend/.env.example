# Copy to .env. These defaults target docker-compose (service hostnames db / redis).
# For running uvicorn directly on your host instead, swap db->localhost, redis->localhost.
DATABASE_URL=postgresql+psycopg://app:app@db:5432/daygraph
REDIS_URL=redis://redis:6379/0
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000"]
